#!/usr/bin/env bash

set -euo pipefail

PORT=8000
DIRECTORY=""

while [[ $# -gt 0 ]]; do
  case $1 in
  -p | --port)
    if [ $# -lt 2 ]; then
      echo "Error: option '$1' requires a port number." >&2
      exit 1
    fi
    PORT="$2"
    shift 2
    ;;
  -h | --help)
    echo "Usage: $0 [OPTIONS] [directory]"
    echo
    echo "Serve files over HTTP so other devices on the network can download them."
    echo
    echo "If ufw is active, the port is temporarily allowed and the rule is"
    echo "removed automatically when the script exits."
    echo
    echo "Options:"
    echo "  -p, --port PORT   Port to listen on (default: 8000)"
    echo "  -h, --help        Show this help"
    echo
    echo "Examples:"
    echo "  $0 ~/Documents"
    echo "  $0 -p 9000 ~/Videos"
    echo "  $0"
    exit 0
    ;;
  -*)
    echo "Error: Unknown option '$1'. Use -h for help." >&2
    exit 1
    ;;
  *)
    DIRECTORY="$1"
    shift
    ;;
  esac
done

if [ -z "$DIRECTORY" ]; then
  DIRECTORY="."
fi

if [ ! -d "$DIRECTORY" ]; then
  echo "Error: '$DIRECTORY' is not a directory." >&2
  exit 1
fi

if ! command -v python3 &>/dev/null; then
  echo "Error: python3 is not installed." >&2
  exit 1
fi

IP=$(hostname -I 2>/dev/null | awk '{print $1}')
if [ -z "$IP" ]; then
  IP="<your-ip>"
fi

UFW_ADDED=0
cleanup() {
  if [ "$UFW_ADDED" = "1" ]; then
    UFW_ADDED=0
    if sudo ufw delete allow "$PORT"/tcp >/dev/null 2>&1; then
      echo "Firewall: removed the temporary rule for port $PORT"
    else
      echo "Warning: could not remove the firewall rule for port $PORT; remove it manually with: " \
        "sudo ufw delete allow $PORT/tcp" >&2
    fi
  fi
}
trap cleanup EXIT INT TERM

if systemctl is-active ufw >/dev/null 2>&1; then
  if sudo ufw allow "$PORT"/tcp >/dev/null 2>&1; then
    UFW_ADDED=1
    echo "Firewall: temporarily allowed port $PORT"
  else
    echo "Warning: ufw is active but port $PORT could not be allowed; other devices may be blocked." >&2
  fi
fi

echo "Serving: $(cd "$DIRECTORY" && pwd)"
echo "Open on the other device: http://${IP}:${PORT}"
echo "Press Ctrl+C to stop."
echo

python3 - "$PORT" "$DIRECTORY" <<'PY'
import functools
import os
import re
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

RANGE_RE = re.compile(r"bytes=(\d*)-(\d*)")


class RangedFile:
    def __init__(self, file, length):
        self._file = file
        self._remaining = length

    def read(self, size=-1):
        if self._remaining <= 0:
            return b""
        if size < 0 or size > self._remaining:
            size = self._remaining
        data = self._file.read(size)
        self._remaining -= len(data)
        return data

    def close(self):
        self._file.close()


class RangeHandler(SimpleHTTPRequestHandler):
    def send_head(self):
        path = self.translate_path(self.path)
        if os.path.isdir(path) or not os.path.isfile(path):
            return super().send_head()
        try:
            file = open(path, "rb")
        except OSError:
            self.send_error(404, "File not found")
            return None
        try:
            stat = os.fstat(file.fileno())
            size = stat.st_size
            start, end, status = 0, size - 1, 200
            range_header = self.headers.get("Range")
            if range_header:
                parsed = self.parse_range(range_header, size)
                if parsed is None:
                    file.close()
                    self.send_error(416, "Requested Range Not Satisfiable")
                    return None
                start, end = parsed
                status = 206
            file.seek(start)
            self.send_response(status)
            self.send_header("Content-Type", self.guess_type(path))
            self.send_header("Content-Length", str(end - start + 1))
            self.send_header("Last-Modified", self.date_time_string(stat.st_mtime))
            self.send_header("Accept-Ranges", "bytes")
            if status == 206:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.end_headers()
            return RangedFile(file, end - start + 1)
        except Exception:
            file.close()
            raise

    @staticmethod
    def parse_range(header, size):
        match = RANGE_RE.fullmatch(header.strip())
        if not match or not any(match.groups()):
            return None
        first, last = match.groups()
        if first:
            start = int(first)
            end = min(int(last), size - 1) if last else size - 1
        else:
            start = max(0, size - int(last))
            end = size - 1
        if start >= size or start > end:
            return None
        return start, end


class QuietServer(ThreadingHTTPServer):
    def handle_error(self, request, client_address):
        # Players abort connections when they buffer, seek or finish; not a server error.
        if isinstance(sys.exc_info()[1], (ConnectionResetError, BrokenPipeError)):
            return
        super().handle_error(request, client_address)


handler = functools.partial(RangeHandler, directory=sys.argv[2])
with QuietServer(("0.0.0.0", int(sys.argv[1])), handler) as server:
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Keyboard interrupt received, exiting.")
PY
